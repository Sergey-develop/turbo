              ]
            }
          }
        ]
      }
    },
    "/api/registrations": {
      "post": {
        "summary": "Идемпотентная регистрация",
        "operationId": "post_api_registrations",
        "responses": {
          "200": {
            "description": "Успех"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Недостаточно прав"
          },
          "409": {
            "description": "Конфликт версии / вместимость / режим"
          },
          "422": {
            "description": "Ошибки валидации"
          },
          "503": {
            "description": "Сервис не настроен или временно недоступен"
          },
          "201": {
            "description": "Заявка, аудит и почтовые задания сохранены; received=true, cancelUrl"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "surname",
                  "name",
                  "company",
                  "position",
                  "email",
                  "phone",
                  "consent",
                  "marketing",
                  "consentVersion",
                  "marketingVersion"
                ],
                "properties": {
                  "surname": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "position": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "consentVersion": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "marketingVersion": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "consent": {
                    "type": "boolean",
                    "const": true
                  },
                  "marketing": {
                    "type": "boolean"
                  },
                  "utm": {
                    "type": "object",
                    "properties": {
                      "utm_source": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "utm_medium": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "utm_campaign": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "utm_term": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "utm_content": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100
            }
          }
        ]
      }
    },
