{
  "name": "turbo-rave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/build-post.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-sqlite --experimental-transform-types --test tests/*.test.mjs",
    "lint": "eslint src server tests scripts --max-warnings 0",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:backup": "node --experimental-sqlite scripts/backup.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "^10.12.0",
    "playwright": "^1.64.1",
    "sass": "^1.94.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "4.92.0"
  }
}
